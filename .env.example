# Shared DagsHub MLflow tracking endpoint
MLFLOW_TRACKING_URI=https://dagshub.com/Nourchenne/ParkVision.mlflow

# Each teammate must use their OWN DagsHub account
MLFLOW_TRACKING_USERNAME=your_dagshub_username

# Personal DagsHub access token — never commit a real token
MLFLOW_TRACKING_PASSWORD=your_dagshub_access_token

# Phase 3 serving and bounded video-MVP limits
PARKVISION_VIDEO_SAMPLE_FPS=1
PARKVISION_MAX_VIDEO_BYTES=104857600
PARKVISION_MAX_VIDEO_DURATION_SECONDS=420
PARKVISION_MAX_VIDEO_FRAMES=450
PARKVISION_MAX_ACTIVE_VIDEO_SESSIONS=1
PARKVISION_VIDEO_SESSION_TTL_SECONDS=1800
PARKVISION_VIDEO_MAX_WIDTH=1280
PARKVISION_VIDEO_MAX_HEIGHT=720
PARKVISION_YOUTUBE_ENABLED=true
PARKVISION_YOUTUBE_SOCKET_TIMEOUT_SECONDS=20
PARKVISION_VIDEO_PROCESSING_TIMEOUT_SECONDS=600
PARKVISION_VIDEO_STORAGE_BUDGET_BYTES=209715200
PARKVISION_VIDEO_ORPHAN_GRACE_SECONDS=3600
PARKVISION_LOCALHOST_ONLY=true
# PARKVISION_FFMPEG_LOCATION=C:\path\to\ffmpeg.exe

# Verified local model cache (default: ~/.parkvision/model-cache on Windows/macOS/Linux)
# PARKVISION_MODEL_CACHE_DIR=C:\path\to\parkvision-model-cache
# PARKVISION_MODEL_CACHE_LOCK_TIMEOUT_SECONDS=120

# Opt-in, loopback-only operator reload (disabled by default)
# PARKVISION_MODEL_RELOAD_ENABLED=false
# PARKVISION_MODEL_RELOAD_MIN_INTERVAL_SECONDS=60
# PARKVISION_MODEL_RELOAD_MAX_FAILURES=3

# Supported MLflow HTTP settings, applied only while downloading an uncached model.
# MLFLOW_HTTP_REQUEST_TIMEOUT=600
# MLFLOW_HTTP_REQUEST_MAX_RETRIES=3
# MLFLOW_HTTP_REQUEST_BACKOFF_FACTOR=2
